    "Use built-in sample prices and headlines instead of live market data. Live data comes from Yahoo Finance and Google News and may be delayed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام أسعار وعناوين نموذجية مدمجة بدلًا من بيانات السوق المباشرة. تأتي البيانات المباشرة من Yahoo Finance وGoogle News وقد تكون متأخرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrierte Beispielkurse und -schlagzeilen statt Live-Marktdaten verwenden. Live-Daten stammen von Yahoo Finance und Google News und können verzögert sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar precios y titulares de ejemplo integrados en lugar de datos de mercado en vivo. Los datos en vivo proceden de Yahoo Finance y Google News y pueden tener retraso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser des cours et des titres d’exemple intégrés au lieu des données de marché en direct. Les données en direct proviennent de Yahoo Finance et Google News et peuvent être différées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שימוש במחירים ובכותרות לדוגמה במקום נתוני שוק חיים. נתונים חיים מגיעים מ-Yahoo Finance ומ-Google News ועשויים להתעכב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव बाज़ार डेटा के बजाय बिल्ट-इन नमूना दाम और सुर्ख़ियाँ इस्तेमाल करें। लाइव डेटा Yahoo Finance और Google News से आता है और इसमें देरी हो सकती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan contoh harga dan berita utama bawaan sebagai pengganti data pasar langsung. Data langsung berasal dari Yahoo Finance dan Google News dan mungkin tertunda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa prezzi e titoli di esempio integrati invece dei dati di mercato in tempo reale. I dati in tempo reale provengono da Yahoo Finance e Google News e possono essere ritardati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイムの市場データの代わりに、内蔵のサンプル株価とニュースを使用します。リアルタイムデータはYahoo FinanceとGoogle Newsから取得し、遅延する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 시장 데이터 대신 내장된 샘플 가격과 헤드라인을 사용합니다. 실시간 데이터는 Yahoo Finance와 Google News에서 제공되며 지연될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik ingebouwde voorbeeldkoersen en -krantenkoppen in plaats van live marktgegevens. Live gegevens komen van Yahoo Finance en Google News en kunnen vertraagd zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używaj wbudowanych przykładowych cen i nagłówków zamiast danych rynkowych na żywo. Dane na żywo pochodzą z Yahoo Finance i Google News i mogą być opóźnione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar preços e manchetes de exemplo em vez de dados de mercado em tempo real. Os dados em tempo real vêm do Yahoo Finance e do Google News e podem ter atraso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать встроенные примеры цен и заголовков вместо рыночных данных в реальном времени. Данные в реальном времени поступают из Yahoo Finance и Google News и могут быть с задержкой."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ราคาและพาดหัวข่าวตัวอย่างในตัวแทนข้อมูลตลาดสด ข้อมูลสดมาจาก Yahoo Finance และ Google News และอาจล่าช้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı piyasa verileri yerine yerleşik örnek fiyatlar ve manşetler kullan. Canlı veriler Yahoo Finance ve Google News’ten gelir ve gecikmeli olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовувати вбудовані приклади цін і заголовків замість ринкових даних у реальному часі. Дані в реальному часі надходять із Yahoo Finance і Google News та можуть бути із затримкою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng giá và tiêu đề tin mẫu tích hợp sẵn thay cho dữ liệu thị trường trực tiếp. Dữ liệu trực tiếp lấy từ Yahoo Finance và Google News và có thể bị trễ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用内置的示例价格和新闻标题，而非实时市场数据。实时数据来自 Yahoo Finance 和 Google 新闻，可能有延迟。"
          }
        }
      }
    },
