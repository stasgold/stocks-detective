    "The detective compares each move with this sector ETF to tell market moves apart from company news." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقارن المحقق كل تحرك بصندوق ETF هذا للقطاع للتمييز بين تحركات السوق وأخبار الشركة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Detektiv vergleicht jede Bewegung mit diesem Sektor-ETF, um Marktbewegungen von Unternehmensnachrichten zu unterscheiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El detective compara cada movimiento con este ETF sectorial para distinguir los movimientos del mercado de las noticias de la empresa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le détective compare chaque mouvement à cet ETF sectoriel pour distinguer les mouvements de marché des actualités de l’entreprise."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבלש משווה כל תנועה לתעודת הסל הסקטוריאלית הזו כדי להבחין בין תנועות שוק לחדשות החברה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाज़ार की हलचल को कंपनी की ख़बर से अलग करने के लिए डिटेक्टिव हर हलचल की तुलना इस सेक्टर ETF से करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detektif membandingkan setiap pergerakan dengan ETF sektor ini untuk membedakan pergerakan pasar dari berita perusahaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il detective confronta ogni movimento con questo ETF settoriale per distinguere i movimenti di mercato dalle notizie aziendali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "探偵は各値動きをこのセクターETFと比較し、市場全体の動きと企業ニュースによる動きを区別します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탐정은 각 움직임을 이 섹터 ETF와 비교하여 시장 움직임과 기업 뉴스를 구분합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De detective vergelijkt elke beweging met deze sector-ETF om marktbewegingen te onderscheiden van bedrijfsnieuws."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detektyw porównuje każdy ruch z tym sektorowym ETF, aby odróżnić ruchy rynku od wiadomości o spółce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O detetive compara cada movimento com este ETF setorial para separar movimentos de mercado de notícias da empresa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Детектив сравнивает каждое движение с этим отраслевым ETF, чтобы отличить движения рынка от новостей компании."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นักสืบจะเปรียบเทียบทุกความเคลื่อนไหวกับ ETF กลุ่มอุตสาหกรรมนี้ เพื่อแยกความเคลื่อนไหวของตลาดออกจากข่าวของบริษัท"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedektif, piyasa hareketlerini şirket haberlerinden ayırmak için her hareketi bu sektör ETF’siyle karşılaştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Детектив порівнює кожен рух із цим галузевим ETF, щоб відрізнити рухи ринку від новин компанії."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thám tử so sánh mỗi biến động với ETF ngành này để phân biệt biến động thị trường với tin tức của công ty."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "侦探会将每次波动与此板块 ETF 比较，以区分市场波动和公司新闻。"
          }
        }
      }
    },
