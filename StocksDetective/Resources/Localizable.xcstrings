    "Private Cloud isn't available right now (needs an Apple Intelligence iPhone with it turned on). Using on-device." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private Cloud غير متاح حاليًا (يتطلب iPhone مع تشغيل Apple Intelligence). يتم استخدام النموذج على الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
