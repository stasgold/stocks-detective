    "On-device: private, offline, fast; reads the top 5 headlines per stock." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على الجهاز: خاص وبلا إنترنت وسريع؛ يقرأ أهم 5 عناوين لكل سهم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Gerät: privat, offline, schnell; liest die 5 wichtigsten Schlagzeilen pro Aktie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el dispositivo: privado, sin conexión y rápido; lee los 5 titulares principales por acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’appareil : privé, hors ligne, rapide ; lit les 5 principaux titres par action."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במכשיר: פרטי, לא מקוון, מהיר; קורא את 5 הכותרות המובילות לכל מניה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिवाइस पर: निजी, ऑफ़लाइन, तेज़; हर शेयर की शीर्ष 5 सुर्ख़ियाँ पढ़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di perangkat: privat, offline, cepat; membaca 5 berita utama teratas per saham."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul dispositivo: privato, offline, veloce; legge i 5 titoli principali per azione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス上：プライベート、オフライン、高速。1銘柄につき上位5件のニュースを読みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 내: 비공개, 오프라인, 빠름. 종목당 상위 5개 헤드라인을 읽습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op het apparaat: privé, offline, snel; leest de top 5 krantenkoppen per aandeel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na urządzeniu: prywatnie, offline, szybko; czyta 5 najważniejszych nagłówków dla każdej akcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No dispositivo: privado, offline e rápido; lê as 5 principais manchetes por ação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На устройстве: приватно, офлайн, быстро; читает 5 главных заголовков по каждой акции."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บนอุปกรณ์: เป็นส่วนตัว ออฟไลน์ รวดเร็ว อ่านพาดหัวข่าว 5 อันดับแรกต่อหุ้น"
