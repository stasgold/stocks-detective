    "Add holdings on the Portfolio tab to get a daily briefing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف مراكز من علامة تبويب المحفظة لتحصل على موجز يومي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge im Tab „Portfolio“ Positionen hinzu, um ein tägliches Briefing zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade posiciones en la pestaña Cartera para recibir un resumen diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des positions dans l’onglet Portefeuille pour recevoir un briefing quotidien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להוסיף אחזקות בכרטיסייה ״תיק השקעות״ כדי לקבל תדריך יומי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोज़ाना ब्रीफ़िंग पाने के लिए पोर्टफ़ोलियो टैब पर होल्डिंग्स जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan kepemilikan di tab Portofolio untuk mendapatkan ringkasan harian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi posizioni nella scheda Portafoglio per ricevere un briefing giornaliero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ポートフォリオ」タブで保有銘柄を追加すると、毎日のブリーフィングを受け取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포트폴리오 탭에서 보유 종목을 추가하면 매일 브리핑을 받을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg posities toe op het tabblad Portefeuille om een dagelijkse briefing te krijgen."
          }
        },
        "pl" : {
