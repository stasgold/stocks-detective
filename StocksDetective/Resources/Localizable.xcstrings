    "Ask follow-up questions about %@. The detective can pull prices and headlines for other tickers to compare." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطرح أسئلة متابعة حول %@. يمكن للمحقق جلب أسعار وعناوين أخبار رموز أخرى للمقارنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle Folgefragen zu %@. Der Detektiv kann Kurse und Schlagzeilen anderer Ticker zum Vergleich abrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz preguntas de seguimiento sobre %@. El detective puede consultar precios y titulares de otros valores para comparar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez des questions de suivi sur %@. Le détective peut récupérer les cours et les titres d’autres valeurs pour comparer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לשאול שאלות המשך על %@. הבלש יכול לשלוף מחירים וכותרות של סימולים אחרים לשם השוואה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के बारे में आगे के सवाल पूछें। तुलना के लिए डिटेक्टिव दूसरे टिकर के दाम और सुर्ख़ियाँ ला सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajukan pertanyaan lanjutan tentang %@. Detektif dapat mengambil harga dan berita utama ticker lain sebagai pembanding."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai domande di approfondimento su %@. Il detective può recuperare prezzi e titoli di altri ticker per confrontarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@について追加の質問ができます。探偵は比較のため、ほかの銘柄の株価やニュースを取得できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 대해 추가 질문을 해보세요. 탐정이 비교를 위해 다른 종목의 가격과 헤드라인을 가져올 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel vervolgvragen over %@. De detective kan koersen en krantenkoppen van andere tickers ophalen om te vergelijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadawaj pytania uzupełniające o %@. Detektyw może pobrać ceny i nagłówki innych tickerów do porównania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça perguntas de acompanhamento sobre %@. O detetive pode buscar preços e manchetes de outros tickers para comparar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задавайте уточняющие вопросы о %@. Детектив может запросить цены и заголовки по другим тикерам для сравнения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถามคำถามต่อเนื่องเกี่ยวกับ %@ นักสืบสามารถดึงราคาและพาดหัวข่าวของหุ้นตัวอื่นมาเปรียบเทียบได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hakkında takip soruları sorun. Dedektif karşılaştırma için başka sembollerin fiyatlarını ve manşetlerini getirebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставте уточнювальні запитання про %@. Детектив може отримати ціни й заголовки інших тикерів для порівняння."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt câu hỏi tiếp theo về %@. Thám tử có thể lấy giá và tiêu đề tin của các mã khác để so sánh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就 %@ 提出后续问题。侦探可以获取其他股票的价格和新闻标题进行比较。"
          }
        }
      }
    },
