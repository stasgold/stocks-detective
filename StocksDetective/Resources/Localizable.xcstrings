    "Today's Private Cloud limit is used up. Using on-device until it resets." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم استنفاد حد Private Cloud لهذا اليوم. يتم استخدام النموذج على الجهاز حتى إعادة التعيين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das heutige Private-Cloud-Limit ist aufgebraucht. Bis zum Zurücksetzen wird das Modell auf dem Gerät verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se agotó el límite diario de Private Cloud. Se usará el modelo en el dispositivo hasta que se restablezca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite Private Cloud du jour est épuisée. Utilisation du modèle sur l’appareil jusqu’à sa réinitialisation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המגבלה היומית של Private Cloud נוצלה. נעשה שימוש במודל שבמכשיר עד לאיפוס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज की Private Cloud सीमा ख़त्म हो गई है। रीसेट होने तक डिवाइस पर मॉडल का उपयोग किया जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas Private Cloud hari ini sudah habis. Menggunakan model di perangkat sampai batas diatur ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il limite giornaliero di Private Cloud è esaurito. Viene usato il modello sul dispositivo fino al ripristino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日のPrivate Cloudの上限に達しました。リセットされるまでデバイス上のモデルを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 Private Cloud 한도를 모두 사용했습니다. 초기화될 때까지 기기 내 모델을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De daglimiet van Private Cloud is op. Het model op het apparaat wordt gebruikt tot de limiet wordt hersteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzisiejszy limit Private Cloud został wyczerpany. Do jego odnowienia używany jest model na urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O limite diário do Private Cloud acabou. Usando o modelo no dispositivo até ser renovado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дневной лимит Private Cloud исчерпан. До его сброса используется модель на устройстве."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ขีดจำกัด Private Cloud ของวันนี้หมดแล้ว จะใช้โมเดลบนอุปกรณ์จนกว่าจะรีเซ็ต"
