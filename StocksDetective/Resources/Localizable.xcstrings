    "Pasted holdings are added; tickers you already have get the new share count." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم إضافة المراكز الملصقة؛ والرموز الموجودة لديك تحصل على عدد الأسهم الجديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingefügte Positionen werden hinzugefügt; bei vorhandenen Tickern wird die Stückzahl aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las posiciones pegadas se añaden; los símbolos que ya tienes reciben el nuevo número de acciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les positions collées sont ajoutées ; les symboles déjà présents prennent le nouveau nombre d’actions."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אחזקות שהודבקו נוספות; סימולים קיימים מקבלים את מספר המניות החדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चिपकाई गई होल्डिंग्स जोड़ी जाती हैं; जो टिकर पहले से हैं उन्हें शेयरों की नई संख्या मिलती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kepemilikan yang ditempel akan ditambahkan; ticker yang sudah ada akan mendapat jumlah saham baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le posizioni incollate vengono aggiunte; i ticker già presenti ricevono il nuovo numero di azioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼り付けた銘柄が追加されます。すでにある銘柄は新しい株数に更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "붙여넣은 종목이 추가되며, 이미 있는 티커는 새 주식 수로 업데이트됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplakte posities worden toegevoegd; tickers die je al hebt krijgen het nieuwe aantal aandelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklejone pozycje są dodawane; tickery, które już masz, otrzymują nową liczbę akcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As posições coladas são adicionadas; tickers que você já tem recebem a nova quantidade de ações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставленные позиции добавляются; для уже имеющихся тикеров обновляется количество акций."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลักทรัพย์ที่วางจะถูกเพิ่ม ส่วนหุ้นที่มีอยู่แล้วจะได้จำนวนหุ้นใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapıştırılan varlıklar eklenir; zaten sahip olduğunuz semboller yeni hisse adedini alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставлені позиції додаються; для наявних тикерів оновлюється кількість акцій."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các khoản nắm giữ được dán sẽ được thêm vào; những mã bạn đã có sẽ nhận số lượng cổ phiếu mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴的持仓将被添加；已有的股票代码会更新为新的股数。"
          }
        }
