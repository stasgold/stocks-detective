"%@ rose %@ while %@ moved %@%% and the S&P 500 moved %@%%. About %@%% of the move is explained by the sector; the rest (%@%%) is specific to %@." = "%1$@ %2$@ चढ़ा, जबकि %3$@ में %4$@%% और S&P 500 में %5$@%% की हलचल हुई। हलचल का लगभग %6$@%% सेक्टर से समझाया जा सकता है; बाकी (%7$@%%) %8$@ से जुड़ा है।";
"%@ fell %@ while %@ moved %@%% and the S&P 500 moved %@%%. About %@%% of the move is explained by the sector; the rest (%@%%) is specific to %@." = "%1$@ %2$@ गिरा, जबकि %3$@ में %4$@%% और S&P 500 में %5$@%% की हलचल हुई। हलचल का लगभग %6$@%% सेक्टर से समझाया जा सकता है; बाकी (%7$@%%) %8$@ से जुड़ा है।";
